              Key="Software\Classes\RenderDic.RDCCapture.1\CLSID"
              Value='{5D6BF029-A6BA-417A-8523-120492B1DCE3}'
              Type="expandable" />

            <RegistryValue Root="HKLM" Id="VerbCAP" Action="write"
              Key="Software\Classes\RenderDic.RDCSettings.1\shell\open\command"
              Value='"[#qrenderdocEXE]" "%1"'
              Type="expandable" />
            <RegistryValue Root="HKLM" Id="VerbDescCAP" Action="write"
              Key="Software\Classes\RenderDic.RDCSettings.1"
              Value='RenderDic Capture Settings (.cap)'
              Type="expandable" />
            <RegistryValue Root="HKLM" Id="VerbIconCAP" Action="write"
              Key="Software\Classes\RenderDic.RDCSettings.1\DefaultIcon"
              Value='[#qrenderdocEXE]'
              Type="expandable" />

          </Component>

          <Component Id='RenderDocCPP' Win64="yes" Guid='F637184C-5C9D-49CE-9A5B-40DAD2FE00E2'>

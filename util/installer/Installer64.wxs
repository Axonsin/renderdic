              <Shortcut Id="startmenuRenderDoc" Directory="ProgramMenuDir" Name="RenderDic" WorkingDirectory='INSTALLDIR' Icon="icon.ico" IconIndex="0" Advertise="yes" />
            </File>

            <RegistryValue Root="HKLM" Id="VerbRDC" Action="write"
              Key="Software\Classes\RenderDic.RDCCapture.1\shell\open\command"
              Value='"[#qrenderdocEXE]" "%1"'
              Type="expandable" />
            <RegistryValue Root="HKLM" Id="VerbDescRDC" Action="write"
              Key="Software\Classes\RenderDic.RDCCapture.1"
              Value='RenderDic Capture Log (.rdc)'
              Type="expandable" />
            <RegistryValue Root="HKLM" Id="VerbIconRDC" Action="write"
              Key="Software\Classes\RenderDic.RDCCapture.1\DefaultIcon"
              Value='[#qrenderdocEXE]'
              Type="expandable" />
